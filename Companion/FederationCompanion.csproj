<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>FederationCompanion</RootNamespace>
    <AssemblyName>FederationCompanion</AssemblyName>
    <Version>0.0.158</Version>
    <AssemblyVersion>0.0.158.0</AssemblyVersion>
    <FileVersion>0.0.158.0</FileVersion>
    <UserSecretsId>federation-companion</UserSecretsId>

    <!-- Idle tray app: workstation GC (no per-core server heaps), return
         unused segments to the OS, and prefer a smaller heap over throughput. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <GCConserveMemory>5</GCConserveMemory>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <!-- CI builds the Windows desktop target from Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>companion.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FederationCompanion.Tests" />
  </ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <EmbeddedResource Include="companion.ico" LogicalName="FederationCompanion.companion.ico" />
  </ItemGroup>

</Project>
