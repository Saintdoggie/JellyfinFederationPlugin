<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>FederationCompanion</RootNamespace>
    <AssemblyName>FederationCompanion</AssemblyName>
    <Version>0.0.159</Version>
    <AssemblyVersion>0.0.159.0</AssemblyVersion>
    <FileVersion>0.0.159.0</FileVersion>
    <UserSecretsId>federation-companion</UserSecretsId>
    <CompanionReleaseChannel Condition="'$(CompanionReleaseChannel)' == ''">stable</CompanionReleaseChannel>

    <!-- Idle tray app: workstation GC (no per-core server heaps), return
         unused segments to the OS, and prefer a smaller heap over throughput. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <GCConserveMemory>5</GCConserveMemory>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <!-- CI builds the Windows desktop target from Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>companion.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FederationCompanion.Tests" />
    <AssemblyMetadata Include="CompanionReleaseChannel" Value="$(CompanionReleaseChannel)" />
  </ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <EmbeddedResource Include="wwwroot/index.html" LogicalName="FederationCompanion.dashboard.html" />
    <EmbeddedResource Include="companion.ico" LogicalName="FederationCompanion.companion.ico" />
  </ItemGroup>

  <!-- WebView2 adds its WPF assembly even to WinForms-only apps. -->
  <Target Name="RemoveUnusedWebViewWpfReference" BeforeTargets="ResolveAssemblyReferences" Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
