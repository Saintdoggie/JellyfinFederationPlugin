<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The installable "Jellyfin Federation Plex" plugin. It deliberately has NO
    reference to the core plugin: Jellyfin loads every plugin folder into its own
    isolated load context and verifies all types before any plugin code runs, so
    a plugin that referenced the core's types could never load from its own
    folder. Instead it carries the Plex add-in (Plex/) as an embedded resource
    and loads it into the core plugin's load context at start-up - see
    PlexAddInHost.cs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.FederationPlex</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.FederationPlex</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <!-- Must equal the core plugin's and the add-in's version: checked at run time. -->
    <Version>0.0.220</Version>
    <AssemblyVersion>0.0.220.0</AssemblyVersion>
    <FileVersion>0.0.220.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\status.html" LogicalName="Jellyfin.Plugin.FederationPlex.Web.status.html" />
    <None Update="meta.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Build the add-in first and embed its DLL; never reference its types. -->
  <ItemGroup>
    <ProjectReference Include="..\Plex\Jellyfin.Plugin.Federation.Plex.csproj" ReferenceOutputAssembly="false" Private="false" OutputItemType="PlexAddInOutput" />
  </ItemGroup>

  <Target Name="EmbedPlexAddIn" AfterTargets="ResolveProjectReferences" BeforeTargets="PrepareResources;CoreCompile">
    <ItemGroup>
      <EmbeddedResource Include="@(PlexAddInOutput)" LogicalName="Jellyfin.Plugin.Federation.Plex.dll" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Federation.Tests" />
  </ItemGroup>

</Project>
