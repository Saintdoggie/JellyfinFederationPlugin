<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.Federation</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Federation</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <Version>0.0.114</Version>
    <AssemblyVersion>0.0.114.0</AssemblyVersion>
    <FileVersion>0.0.114.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\federation-badge.js" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <!-- Companion is a separate standalone app (its own .csproj) living in a
         subdirectory of this repo, not part of this plugin - without this
         exclusion the default SDK glob also sweeps up its source *and* its
         own build output (obj\**\*.AssemblyInfo.cs etc.), which collides with
         this project's own generated assembly attributes. -->
    <Compile Remove="Companion\**" />
    <None Remove="Companion\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="meta.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="thumb.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.6" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.6" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Federation.Tests" />
  </ItemGroup>

</Project>
