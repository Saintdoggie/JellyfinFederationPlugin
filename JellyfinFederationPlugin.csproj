<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**</DefaultItemExcludes>
    <AssemblyName>Jellyfin.Plugin.Federation</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Federation</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <Version>0.0.199</Version>
    <AssemblyVersion>0.0.199.0</AssemblyVersion>
    <FileVersion>0.0.199.0</FileVersion>
    <!-- Keep the catalog DLL reproducible when its archive/checksum are committed. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\admin\configPage.html" />
    <EmbeddedResource Include="Web\client\federation-badge.js" />
    <EmbeddedResource Include="Web\client\federation-adaptive.js" />
    <EmbeddedResource Include="Web\vendor\hls.light.min.js" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <!-- Companion is a separate standalone app (its own .csproj) living in a
         subdirectory of this repo, not part of this plugin - without this
         exclusion the default SDK glob also sweeps up its source *and* its
         own build output (obj\**\*.AssemblyInfo.cs etc.), which collides with
         this project's own generated assembly attributes. -->
    <Compile Remove="Companion\**" />
    <None Remove="Companion\**" />
    <Compile Remove="Companion.Tests\**" />
    <Compile Remove="QuicTransport\**" />
    <None Remove="QuicTransport\**" />
    <None Remove="Companion.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="meta.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="thumb.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- MsQuic for the direct link (see native/README.md); ships in the release zip at the same paths. -->
    <None Include="native\linux-x64\libmsquic.so.2;native\linux-arm64\libmsquic.so.2">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Identity)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

  <!-- The direct link's QUIC code, embedded and loaded into its own context at
       run time (see Services/DirectLink/QuicTransportHost.cs). -->
  <ItemGroup>
    <ProjectReference Include="QuicTransport\Jellyfin.Plugin.Federation.QuicTransport.csproj" ReferenceOutputAssembly="false" Private="false" OutputItemType="QuicTransportOutput" />
  </ItemGroup>

  <Target Name="EmbedQuicTransport" AfterTargets="ResolveProjectReferences" BeforeTargets="PrepareResources;CoreCompile">
    <ItemGroup>
      <EmbeddedResource Include="@(QuicTransportOutput)" LogicalName="Jellyfin.Plugin.Federation.QuicTransport.dll" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Federation.Tests" />
  </ItemGroup>

</Project>
